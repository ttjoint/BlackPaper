# 源码统一用 LF 存储，检出时由 git 按平台处理
* text=auto eol=lf

# C# / 项目文件
*.cs       text eol=lf
*.csproj   text eol=lf
*.sln      text eol=crlf
*.config   text eol=lf
*.resx     text eol=lf
*.settings text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Shell 钩子必须是 LF，否则在 *nix 上无法执行
githooks/* text eol=lf

# 二进制
*.ico      binary
*.png      binary
*.exe      binary
*.dll      binary
*.pdb      binary
*.nupkg    binary
